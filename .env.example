# The Entity In The Shed (Rust clone) - configuration
#
# Copy this file to `.env` in this folder. `.env` is never committed; this template is.
#
# Every name in this file is read by the code, and every name the code reads is in this file.
# Stage 1 boots the log, the storage root and `GET /health`, so it documents the settings those
# three read. The other settings arrive with the routes that read them, stage by stage, and this
# file grows with them rather than listing 140 keys nothing reads yet.
#
# A value set by the launcher is overridden by the same name here (`load_dotenv(...,
# override=True)`). A name this file does not mention keeps its default, written next to it.
# Blank means "unset": an empty value and an absent name are different things to this app.

# Where the app keeps its runtime state: transcripts, mind state, generated audio, logs.
# A relative path is resolved against this folder. Blank uses %LOCALAPPDATA%\entity-in-the-shed
# (or $HOME on a POSIX system). The directory is created at startup, and nothing the app
# generates is written inside the repo.
STORAGE_ROOT=

# The address the HTTP server answers on. A blank APP_HOST binds every interface.
# The source also read FLASK_HOST / FLASK_PORT / HOST / PORT as fallbacks; the clone reads only
# these two names, which is the principle-24 correction recorded in docs/PARITY.md.
APP_HOST=0.0.0.0
APP_PORT=5005

# The two model names GET /health reports. Both default to blank: a clone with no AI_MODEL of
# its own chooses the model for a turn by discovery, which is Stage 2. A name is trimmed, and a
# trailing `:latest` is dropped only from a name that has more than one colon - so
# registry:5000/model:latest is a model with a host, and model:latest is a tag to keep.
AI_MODEL=
LM_ENGINE_NORMAL_MODEL=

# The McTrader MCP server. Leave all seven blank to run without it: /health then says
# "configured": false and names the reason.
#
# MCTRADER_MCP_TRANSPORT may be left blank, and is then inferred from what is set: a command
# means stdio, a URL means sse. Only the three spellings stdio, sse and streamable-http are an
# explicit choice; anything else falls back to the inference.
#   stdio: COMMAND, plus ARGS and ENV as JSON documents - MCTRADER_MCP_ARGS=["--serve", "8765"],
#          MCTRADER_MCP_ENV={"TOKEN": "t"}. Both are read only for a stdio server.
#   http:  URL, with TRANSPORT of sse or streamable-http.
# TIMEOUT is seconds, floored at 5. SERVER_NAME is what the MCP session calls the server.
MCTRADER_MCP_TRANSPORT=
MCTRADER_MCP_COMMAND=
MCTRADER_MCP_ARGS=
MCTRADER_MCP_ENV=
MCTRADER_MCP_URL=
MCTRADER_MCP_TIMEOUT=600
MCTRADER_MCP_SERVER_NAME=mctrader

# How much the app says about itself: DEBUG, INFO, WARNING or ERROR. Anything else - including
# a blank value or a typo - keeps INFO. The name is matched case-insensitively. This is the only
# dial: RUST_LOG is not read, so a shell variable cannot quietly change what the app writes.
LOG_LEVEL=INFO

# Principle 24 fixes for the keys that arrive in later stages: every name is UPPERCASE, and a
# percentage key ends in _PERCENT with a double-quoted value ending in % - for example
# ENTITY_MARKET_MOVE_PERCENT="2.0%". No percentage key is read at Stage 1.
