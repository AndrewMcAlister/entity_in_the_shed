# The Entity In The Shed (Rust) -- Environment Configuration
#
# Copy this file to .env next to entity_in_the_shed.exe. Every name here is
# read by the clone at startup (crates/shed-config); the shed-gates settings
# gate keeps this file and the code's read set in step, in both directions,
# so a key can neither be read undocumented nor documented unread.
#
# The old Python service (entity-in-the-shed) reads its own .env next to
# agent.py; these two files are independent. Names the clone does not read
# yet -- FLASK_HOST, FLASK_PORT, USE_WAITRESS, the LM_ENGINE_* sampling
# block, the TTS_* block, the ENTITY_* mind block, SERVICE_* -- join this
# file as their stages port, and this comment shrinks as they do.
#
# Values are read with python-dotenv's grammar: unquoted values keep
# backslashes and spaces verbatim, " #" after whitespace starts a comment,
# and ${VAR} expands from earlier lines of this file first, then from the
# process environment.

# Storage
# One root for conversations, the audio cache and mind state. A relative
# value resolves next to the executable; the default is created if missing.
# It is deliberately distinct from the Python app's
# C:\Temp\entity-in-the-shed so both services can run at once.
STORAGE_ROOT=C:\Temp\entity_in_the_shed

# Logging
# DEBUG, INFO, WARNING, ERROR or CRITICAL (WARN and FATAL are accepted
# aliases); anything else reads as INFO. Only this app's lines are written
# -- library chatter stays at WARN. RUST_LOG is never read.
LOG_LEVEL=INFO

# Models
# AI_MODEL is the active selection; LM_ENGINE_NORMAL_MODEL is the normal-mode
# default. A registry name ending in :latest loses the tag (the
# registry:5000/model:latest case); a plain model:latest keeps it.
AI_MODEL=
LM_ENGINE_NORMAL_MODEL=

# Server
# The clone reads APP_HOST/APP_PORT (the Python app reads FLASK_HOST/
# FLASK_PORT, a leftover no page can see). Both services default to port
# 5005: to run the old one and the new one at once, change one of them.
APP_HOST=0.0.0.0
APP_PORT=5005

# McTrader MCP
# The /health block reports this configuration; the live session arrives
# with the Stage 5 client.
MCTRADER_MCP_SERVER_NAME=mctrader
# Blank transport auto-detects: COMMAND implies stdio, URL implies sse. An
# unrecognised value is ignored and auto-detection applies.
MCTRADER_MCP_TRANSPORT=streamable-http
MCTRADER_MCP_COMMAND=
# JSON list of strings and JSON object of strings (stdio servers only).
# The clone parses both at startup: malformed JSON names the key and the
# service refuses to boot, rather than failing the first MCP call.
MCTRADER_MCP_ARGS=
MCTRADER_MCP_ENV=
MCTRADER_MCP_URL=http://127.0.0.1:8765/mcp
# Per-request timeout in seconds; the effective floor is 5, so a small
# number is raised rather than refused.
MCTRADER_MCP_TIMEOUT=600
# How long a discovered tool list is reused before asking again, in seconds;
# the effective floor is 5.
MCTRADER_MCP_CACHE_TTL=30
